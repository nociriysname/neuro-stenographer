# Скопируйте в .env и настройте. Не добавляйте .env в Git.
# Используется скриптами оценки качества (WER / DER / RTF) на собственном стенде.

# Устройство для пакетного прогона (adb devices)
ADB_SERIAL=
# Папка с тестовыми записями и эталонными JSON
EVAL_DATA_DIR=eval/data
# Куда складывать результаты прогона
EVAL_OUTPUT_DIR=artifacts/test-results
# Нормализация текста перед WER: lower, punct, yo (уточняется у организаторов)
WER_NORMALIZATION=lower,punct,yo
# Допуск по границам для DER, секунды
DER_COLLAR_SEC=0.25
